digraph azops_cli {
    graph [
        label="azops-cli Architecture"
        labelloc=t
        fontsize=20
        fontname="Helvetica"
        rankdir=TB
        splines=polyline
        nodesep=0.6
        ranksep=0.9
        bgcolor="#F8F9FA"
        pad=0.5
    ]
    node [fontname="Helvetica" fontsize=11 style="filled,rounded" shape=box margin="0.15,0.1"]
    edge [fontname="Helvetica" fontsize=9 color="#555555"]

    // ─── Entry Point ───────────────────────────────────────────────────────────
    subgraph cluster_cmd {
        label="cmd/azops  (main)"
        style=filled color="#E3F2FD" fontcolor="#0D47A1" fontsize=13
        node [fillcolor="#BBDEFB" color="#1976D2"]

        main        [label="main()\nsignal + os.Exit"]
        run         [label="run()\norchestrate startup"]
        appDeps     [label="applicationDependencies()\nbind services → Dependencies"]
        unsupported [label="unsupportedServices{}\nnoop stubs\n(Release)"]
    }

    main -> run
    run  -> appDeps
    appDeps -> unsupported [style=dashed label="implements\nmissing services (Release)"]
    appDeps -> azTestImpl  [style=dashed label="NewAzureTestService"]

    // ─── CLI ───────────────────────────────────────────────────────────────────
    subgraph cluster_cli {
        label="internal/cli"
        style=filled color="#E8F5E9" fontcolor="#1B5E20" fontsize=13
        node [fillcolor="#C8E6C9" color="#388E3C"]

        cliParse  [label="Parse(args)\n→ Command"]
        cliConn   [label="ResolveConnection(url, lookup)\n→ Connection{URL, PAT}"]
        Command   [label="Command{Selection, ConfigPath,\nSecretPath, URL, DryRun}"]
        Selection [label="Selection{Kind, Path}"]
    }

    run -> cliParse
    run -> cliConn
    cliParse -> Command
    cliParse -> Selection
    Command -> Selection

    // ─── Config ────────────────────────────────────────────────────────────────
    subgraph cluster_config {
        label="internal/config"
        style=filled color="#FFF3E0" fontcolor="#E65100" fontsize=13
        node [fillcolor="#FFE0B2" color="#F57C00"]

        cfgLoader    [label="Loader.Load()\n→ LoadedInputs"]
        cfgValidator [label="Validate(selection, inputs)"]
        cfgTypes     [label="Config / Secrets\n(YAML desired state)"]
        cfgEnums     [label="EnableDisable / OnOff\nAccessValue / Role"]
    }

    run -> cfgLoader
    cfgLoader -> cfgTypes
    run -> cfgValidator
    cfgValidator -> cfgTypes [style=dashed]
    cfgTypes -> cfgEnums [style=dashed label="uses"]

    // ─── Azure ─────────────────────────────────────────────────────────────────
    subgraph cluster_azure {
        label="internal/azure"
        style=filled color="#FCE4EC" fontcolor="#880E4F" fontsize=13
        node [fillcolor="#F8BBD0" color="#C2185B"]

        azClient   [label="Client{baseURL, pat, httpClient}\nNewClient()"]
        azAdapter  [label="Adapter{client, service}\nDo(ctx, Request, output)"]
        azServices [label="Services{Projects, Identity,\nGraph, Security, SecurityACL,\nBuild, Release, DistributedTask,\nPipelinePerms, AgentPools,\nServiceHooks, Dashboards,\nServiceEndpoints, Test, Policy}\nNewServices()"]
        azSvcDef   [label="Service{Name, Scope,\nPrefix, APIVersion}\n(13 constants)"]
        azUnsup    [label="Unsupported()\n→ UnsupportedOperationError"]
    }

    run -> azClient [label="NewClient(url, PAT)"]
    azClient -> azAdapter [label="wraps"]
    azAdapter -> azServices [label="grouped into"]
    azServices -> azSvcDef [style=dashed label="typed by"]
    appDeps -> azServices [label="NewServices(client)"]
    azServices -> azUnsup [style=dashed label="stub returns"]

    // ─── Report ────────────────────────────────────────────────────────────────
    subgraph cluster_report {
        label="internal/report"
        style=filled color="#EDE7F6" fontcolor="#311B92" fontsize=13
        node [fillcolor="#D1C4E9" color="#512DA8"]

        reporter [label="Reporter{writer, redactor}\nWarning() / Render()"]
        redactor [label="Redactor{replacer}\nNewRedactor(pat, secrets)\nRedact(value)"]
    }

    run -> reporter [label="New(stdout, redactor)"]
    run -> redactor [label="NewRedactor(PAT, secrets)"]
    reporter -> redactor [label="passes output through"]

    // ─── Domain ────────────────────────────────────────────────────────────────
    subgraph cluster_domain {
        label="internal/domain"
        style=filled color="#E0F2F1" fontcolor="#004D40" fontsize=13
        node [fillcolor="#B2DFDB" color="#00796B"]

        domModule    [label="Module interface\nID() / Component()\nPlan() / Apply()"]
        domPlan      [label="Plan{Module, Component,\nOperations[]Operation}"]
        domExecGraph [label="ExecutionGraph\n{Stages[]ExecutionStage}"]
        domExecStage [label="ExecutionStage\n{Number, Modules[]Module}"]
        domResult    [label="ModuleResult / FinalResult\nOutcome enum"]
        domErrors    [label="UsageError / DiscoveryError\nDecodeError / ValidationError\nConnectionError / APIError\nModuleError"]
    }

    domModule -> domPlan      [style=dashed label="returns"]
    domExecGraph -> domExecStage [label="contains"]
    domExecStage -> domModule    [label="holds"]
    domModule -> domResult    [style=dashed label="produces"]

    // ─── Detector ──────────────────────────────────────────────────────────────
    subgraph cluster_detector {
        label="internal/detector"
        style=filled color="#FFF9C4" fontcolor="#F57F17" fontsize=13
        node [fillcolor="#FFF176" color="#F9A825"]

        detRegistry  [label="Registry{ordered, byPath}\nNewRegistry(deps)"]
        detDeps      [label="Dependencies{\n  GroupDirectory\n  Security / Repositories\n  Dashboards / AgentPools\n  Release / ServiceConnections\n  Test / ServiceHook\n  Settings / Overview\n  Environments / Library\n  TaskGroups / DeploymentGroup\n  PipelineAccess / ReleaseAccess\n}"]
        detDetector  [label="Detector{registry}\nNew(registry)\nDetect(selection, config)\n→ ExecutionGraph"]
    }

    run -> detDetector  [label="New(registry).Detect(...)"]
    run -> detRegistry  [label="NewRegistry(deps)"]
    detRegistry -> detDeps [label="consumes"]
    detDetector -> detRegistry [label="uses"]
    detDetector -> domExecGraph [label="builds"]
    appDeps -> detDeps  [label="fills"]

    // ─── Runner ────────────────────────────────────────────────────────────────
    subgraph cluster_runner {
        label="internal/runner"
        style=filled color="#ECEFF1" fontcolor="#263238" fontsize=13
        node [fillcolor="#CFD8DC" color="#455A64"]

        runner     [label="Runner{}\nNew()\nRun(ctx, graph, input, opts)\n→ FinalResult"]
        runStage   [label="runStage()\nconcurrent goroutines\n(sync.WaitGroup)"]
        runModule  [label="runModule()\nPlan → Apply\nor DryRun → Planned"]
    }

    run -> runner    [label="New().Run(ctx, graph, input, opts)"]
    runner -> runStage  [label="per stage"]
    runStage -> runModule [label="goroutine per module"]
    runModule -> domModule [label="calls Plan() / Apply()"]
    runner -> domResult [label="aggregates →"]

    // ─── Permissions (shared) ──────────────────────────────────────────────────
    subgraph cluster_permissions {
        label="internal/modules/permissions"
        style=filled color="#F3E5F5" fontcolor="#4A148C" fontsize=13
        node [fillcolor="#E1BEE7" color="#7B1FA2"]

        permDir    [label="GroupDirectory interface\nListGroups(ctx, project)"]
        permAzDir  [label="AzureGroupDirectory\nNewAzureGroupDirectory(adapter)"]
        permCache  [label="CachedGroupDirectory\nNewCachedGroupDirectory(source)\n(sync.Once per project)\nInvalidate(project)"]
        permPlan   [label="PlanAccess(assignments, bits,\nprincipals, current)\n→ []AccessChange\n\nPlanAccessFull(assignments, bits,\nprincipals)\n→ []AccessChange (all entries,\nregardless of current state)"]
        permRoles  [label="PlanRoles(assignments,\nprincipals, current, supported)\n→ []RoleChange"]
        permGroup  [label="Group{Name, Descriptor, TFID}\nPrincipal{Alias, Name, Descriptor, TFID}"]
    }

    permDir  -> permAzDir [label="implemented by"]
    permAzDir -> permCache [label="wrapped by"]
    permCache -> permDir  [style=dashed label="satisfies"]
    appDeps -> permCache  [label="NewCachedGroupDirectory(...)"]

    // ─── ProjectSettings modules ───────────────────────────────────────────────
    subgraph cluster_ps_modules {
        label="internal/modules/projectsettings  (stage 1-2, 5-6)"
        style=filled color="#E8EAF6" fontcolor="#1A237E" fontsize=13
        node [fillcolor="#C5CAE9" color="#303F9F"]

        psSecurity   [label="securityModule\nstage 1\nNewSecurity(SecurityService)"]
        psRepos      [label="repositoriesModule\nstage 2\nNewRepositories(...)"]
        psDash       [label="dashboardsModule\nstage 2\nNewDashboards(...)"]
        psAgents     [label="agentPoolsModule\nstage 2\nNewAgentPools(...)"]
        psRelease    [label="releaseModule\nstage 2\nNewRelease(...)"]
        psSvcConn    [label="serviceConnectionsModule\nstage 2\nNewServiceConnections(...)\n\ncreate section (secret.yaml):\n  overwrite: true|false\n  type / auth / url / user / password\n  apiKey / token / grant_access\n\npermissions section:\n  project-level: Creator/User/Reader via PlanRoles()\n  per-endpoint: Creator groups → User via PlanRoles()\n    (Creator inherited = User, idempotent)"]
        psTest       [label="testModule\nstage 2\nNewTest(...)"]
        psSvcHook    [label="serviceHookModule\nstage 5\nNewServiceHook(...)"]
        psSettings   [label="settingsModule\nstage 6\nNewSettings(...)"]
        psOverview   [label="overviewModule\nstage 6\nNewOverview(...)"]

        psSecSvc  [label="SecurityService\n(GroupDirectory + CreateGroup\n+ ReadProjectAccess\n+ SetProjectAccess)"]
        psRepoSvc [label="RepositoryService"]
        psDashSvc [label="DashboardService"]
        psAgentSvc [label="AgentPoolService"]
        psRelSvc  [label="ReleaseService"]
        psSvcCSvc [label="ServiceConnectionService\nListServiceConnections\nUpsertServiceConnection\nReadServiceConnectionRoles / SetServiceConnectionRoles\nReadEndpointRoles / SetEndpointRoles"]
        psTestSvc [label="TestService"]
        psSvcHSvc [label="ServiceHookService"]
        psSetSvc  [label="SettingsService"]
        psOvSvc   [label="OverviewService"]
    }

    psSecurity -> psSecSvc   [label="uses"]
    psRepos    -> psRepoSvc  [label="uses"]
    psDash     -> psDashSvc  [label="uses"]
    psAgents   -> psAgentSvc [label="uses"]
    psRelease  -> psRelSvc   [label="uses"]
    psSvcConn  -> psSvcCSvc  [label="uses"]
    psTest     -> psTestSvc  [label="uses"]
    psSvcHook  -> psSvcHSvc  [label="uses"]
    psSettings -> psSetSvc   [label="uses"]
    psOverview -> psOvSvc    [label="uses"]

    psSecurity -> permPlan  [label="PlanAccess()"]
    psSecurity -> permRoles [style=dashed]
    psRepos    -> permPlan  [label="PlanAccess()"]
    psAgents   -> permRoles [label="PlanRoles()"]
    psSvcConn  -> permRoles [label="PlanRoles()"]
    psSecurity -> permGroup [style=dashed]

    // ─── Pipelines modules ─────────────────────────────────────────────────────
    subgraph cluster_pl_modules {
        label="internal/modules/pipelines  (stage 3-4)"
        style=filled color="#E1F5FE" fontcolor="#01579B" fontsize=13
        node [fillcolor="#B3E5FC" color="#0288D1"]

        plEnv    [label="environmentsModule\nstage 3\nNewEnvironments(...)"]
        plLib    [label="libraryModule\nstage 3\nNewLibrary(...)"]
        plTask   [label="taskGroupsModule\nstage 3\nNewTaskGroups(...)"]
        plDeploy [label="deploymentGroupModule\nstage 3\nNewDeploymentGroup(...)"]
        plPipes  [label="pipelinesModule (scopedModule)\nstage 4 / NewPipelines(...)\nPlan: PlanAccess (delta) +\n  PlanAccessFull (full ACE set\n  for sub-folders on drift)\nApply: SetScopedAccess(\n  changes, allACEs)"]
        plRel    [label="releasesModule (scopedModule)\nstage 4 / NewReleases(...)\nPlan: PlanAccess (delta) +\n  PlanAccessFull (full ACE set\n  for sub-folders on drift)\nApply: SetScopedAccess(\n  changes, allACEs)"]

        plEnvSvc  [label="EnvironmentService\nReadEnvironmentRoles / SetEnvironmentRoles"]
        plLibSvc  [label="LibraryService\nReadLibraryRoles / SetLibraryRoles\nListVariableGroups / UpsertVariableGroup\n\ncreate section fields (secret.yaml):\n  pipeline_permissions: open|restrict\n  overwrite: true|false\n  variables[].is_secret: true|false"]
        plTaskSvc [label="TaskGroupService\nReadTaskGroupAccess / SetTaskGroupAccess"]
        plDeplSvc [label="DeploymentGroupService\nReadDeploymentGroupRoles / SetDeploymentGroupRoles"]
        plScopSvc [label="ScopedPermissionService\nReadScopedAccess(project, path)\n→ AccessSnapshot{\n  Bits, Values,\n  inheritPermissions flag\n}\nSetScopedAccess(project, path,\n  changes, allACEs)"]
    }

    plEnv    -> plEnvSvc  [label="uses"]
    plLib    -> plLibSvc  [label="uses"]
    plTask   -> plTaskSvc [label="uses"]
    plDeploy -> plDeplSvc [label="uses"]
    plPipes  -> plScopSvc [label="uses"]
    plRel    -> plScopSvc [label="uses"]

    plEnv    -> permRoles [label="PlanRoles()"]
    plLib    -> permRoles [label="PlanRoles()"]
    plTask   -> permPlan  [label="PlanAccess()"]
    plDeploy -> permRoles [label="PlanRoles()"]
    plPipes  -> permPlan  [label="PlanAccess()\nPlanAccessFull()"]
    plRel    -> permPlan  [label="PlanAccess()\nPlanAccessFull()"]

    // ─── AzurePipelineScopedService ────────────────────────────────────────────
    subgraph cluster_az_scoped {
        label="internal/modules/pipelines  (azure_scoped.go)"
        style=filled color="#FBE9E7" fontcolor="#BF360C" fontsize=13
        node [fillcolor="#FFCCBC" color="#E64A19"]

        azScoped [label="AzurePipelineScopedService\nNewAzurePipelineScopedService(services)  // build\nNewAzureReleaseScopedService(services)   // release\n\nresolveProjectID(project) → GUID\nensureBuildFolder(project, path)   PUT build/folders?path=\\Dev\nensureReleaseFolder(project, path) POST release/folders?path=\\Dev\n\nReadScopedAccess(project, path):\n  GET accesscontrollists/{ns}?token=…&recurse=false\n  sub-folder: if inheritPermissions=true → treat as empty\n  → AccessSnapshot{Bits, Values}\n\nSetScopedAccess(project, path, changes, allACEs):\n  root  /  → POST AccessControlEntries/{ns}  merge:true\n  sub-folder → POST accesscontrollists/{ns}\n                {value:[{token, inheritPermissions:false,\n                 acesDictionary:{…only Allow/Deny…}}]}\n\nbootstrapReleaseDataspace(project):\n  1. POST release/folders?path=\\\n  2. fallback: POST release/definitions (temp pipeline)\n     then DELETE\n\nisDataspaceError(err) → bool\nbuildToken / releaseToken → ACL token string"]
    }

    azScoped -> plScopSvc [style=dashed label="implements"]
    azScoped -> azServices [label="uses Projects,\nSecurityACL,\nBuild, Release"]

    // ─── Domain interface wiring ───────────────────────────────────────────────
    psSecurity -> domModule [style=dashed label="implements"]
    psRepos    -> domModule [style=dashed]
    psDash     -> domModule [style=dashed]
    psAgents   -> domModule [style=dashed]
    psRelease  -> domModule [style=dashed]
    psSvcConn  -> domModule [style=dashed]
    psTest     -> domModule [style=dashed]
    psSvcHook  -> domModule [style=dashed]
    psSettings -> domModule [style=dashed]
    psOverview -> domModule [style=dashed]
    plEnv      -> domModule [style=dashed]
    plLib      -> domModule [style=dashed]
    plTask     -> domModule [style=dashed]
    plDeploy   -> domModule [style=dashed]
    plPipes    -> domModule [style=dashed]
    plRel      -> domModule [style=dashed]

    // ─── Registry factory wiring ───────────────────────────────────────────────
    detRegistry -> psSecurity [label="factory→" style=dashed]
    detRegistry -> psRepos    [style=dashed]
    detRegistry -> psDash     [style=dashed]
    detRegistry -> psAgents   [style=dashed]
    detRegistry -> psRelease  [style=dashed]
    detRegistry -> psSvcConn  [style=dashed]
    detRegistry -> psTest     [style=dashed]
    detRegistry -> psSvcHook  [style=dashed]
    detRegistry -> psSettings [style=dashed]
    detRegistry -> psOverview [style=dashed]
    detRegistry -> plEnv      [style=dashed]
    detRegistry -> plLib      [style=dashed]
    detRegistry -> plTask     [style=dashed]
    detRegistry -> plDeploy   [style=dashed]
    detRegistry -> plPipes    [style=dashed]
    detRegistry -> plRel      [style=dashed]

    // ─── Azure services wired to module services ───────────────────────────────
    subgraph cluster_azure_impl {
        label="internal/modules/projectsettings  (azure_services.go + dashboards_azure.go)"
        style=filled color="#FCE4EC" fontcolor="#880E4F" fontsize=11
        node [fillcolor="#F8BBD0" color="#C2185B"]

        azSecImpl   [label="AzureSecurityService\nNewAzureSecurityService(services, dir)"]
        azHookImpl  [label="AzureServiceHookService\nNewAzureServiceHookService(services)"]
        azAgentImpl [label="AzureAgentPoolService\nNewAzureAgentPoolService(services)"]
        azTestImpl  [label="AzureTestService\nNewAzureTestService(services)\n\nGET  /{project}/_apis/test/resultretentionsettings\nPATCH /{project}/_apis/test/resultretentionsettings\n\nautomatedResultsRetentionDuration\nmanualResultsRetentionDuration"]
        azDashImpl  [label="AzureDashboardService\nNewAzureDashboardService(services)\n\nNamespace: DashboardsPrivileges (8adf73b7-…)\nToken: $/projectId/teamId  (default team)\nDescriptor: team group ACE (suffix -1-…, non-system)\nBits: Read=1, Create=2, Edit=4, Delete=8, ManagePerm=16\n\nresolveProjectAndDefaultTeam(project):\n  GET _apis/projects → projectId\n  GET _apis/projects/{id}/teams → default teamId\n    (match name '{project} Team' or description 'default')\n\nRead:  GET  _apis/accesscontrollists/{ns}?token=$/pid/tid\n  → pick non-system ACE → allow/deny bits\n  Create/Edit/Delete = bit not in deny AND in allow\n\nWrite: POST _apis/AccessControlEntries/{ns}  merge:true\n  allow = Read(1) + enabled bits\n  deny  = ManagePerm(16) + disabled bits"]
        azSvcConnImpl [label="AzureServiceConnectionService\nNewAzureServiceConnectionService(services, dir)\n\nScope: distributedtask.project.serviceendpointrole\n  Roles: Administrator, Creator, User, Reader\n\nListServiceConnections:\n  GET /{project}/_apis/serviceendpoint/endpoints\n  + GET /_apis/pipelines/pipelinepermissions/endpoint/{id}\n    → grant_access (allPipelines.authorized)\n\nUpsertServiceConnection (secret.yaml):\n  POST endpoints  (create)\n  PUT  endpoints/{id}  (update if overwrite:true)\n  PATCH pipelinepermissions/endpoint/{id}  → grant_access\n  Types: dockerregistry, externalnugetfeed, externalnpmregistry\n         sonarqube, generic\n\nReadServiceConnectionRoles / SetServiceConnectionRoles:\n  GET/PUT securityroles/scopes/{scope}/roleassignments/resources/{projectId}\n\nReadEndpointRoles / SetEndpointRoles:\n  GET/PUT securityroles/scopes/{scope}/roleassignments/resources/{projectId}_{endpointId}\n  Creator (inherited) treated as User for idempotency"]

    azServices -> azSecImpl   [label="uses adapters"]
    azServices -> azHookImpl  [label="uses adapters"]
    azServices -> azAgentImpl [label="uses adapters"]
    azServices -> azTestImpl  [label="uses Test adapter"]
    azServices -> azDashImpl  [label="uses SecurityACL,\nProjects"]
    azServices -> azSvcConnImpl [label="uses ServiceEndpoints,\nSecurityRoles, Projects,\nPipelinePerms"]
    azSecImpl      -> psSecSvc   [style=dashed label="implements"]
    azHookImpl     -> psSvcHSvc  [style=dashed label="implements"]
    azAgentImpl    -> psAgentSvc [style=dashed label="implements"]
    azTestImpl     -> psTestSvc  [style=dashed label="implements"]
    azDashImpl     -> psDashSvc  [style=dashed label="implements"]
    azSvcConnImpl  -> psSvcCSvc  [style=dashed label="implements"]
    // ─── Azure pipeline service implementations ────────────────────────────────
    subgraph cluster_azure_pipelines_impl {
        label="internal/modules/pipelines  (azure_pipelines_services.go)"
        style=filled color="#E8F5E9" fontcolor="#1B5E20" fontsize=11
        node [fillcolor="#C8E6C9" color="#388E3C"]

        azEnvImpl  [label="AzureEnvironmentService\nNewAzureEnvironmentService(services, dir)\n\nEnvironment namespace: 83d4c2e6…\nToken: Environments/{projectId}\nRoles → ACL allow bits:\n  Administrator=63, Creator=33\n  User=17, Reader=1\n\nGET  accesscontrollists/{ns}?token=…\nPOST AccessControlEntries/{ns}"]
        azTaskImpl [label="AzureTaskGroupService\nNewAzureTaskGroupService(services)\n\nMetaTask namespace: f6a4de49…\nToken: {projectId}\nBits: Administer=1, Edit=2, Delete=4\n\nGET  accesscontrollists/{ns}?token=…\nPOST AccessControlEntries/{ns}"]
        azDeplImpl [label="AzureDeploymentGroupService\nNewAzureDeploymentGroupService(services)\n\nDistributedTask namespace: 101eae8c…\nToken: MachineGroups/{projectId}\nRoles → ACL allow bits:\n  Administrator=59, Creator=33\n  User=17, Reader=1\n\nGET  accesscontrollists/{ns}?token=…\nPOST AccessControlEntries/{ns}"]
        azLibImpl  [label="AzureLibraryService\nNewAzureLibraryService(services, dir)\n\nLibrary namespace: b7e84409…\nToken: Library/{projectId}\nRoles → ACL allow bits:\n  Administrator=63, Creator=5\n  User=17, Reader=1\n\nGET  accesscontrollists/{ns}?token=…\nPOST AccessControlEntries/{ns}\n\nListVariableGroups:\n  GET  /{project}/_apis/distributedtask/variablegroups\n  GET  /{project}/_apis/pipelines/pipelinepermissions/\n          variablegroup/{id}   → open / restrict\n\nUpsertVariableGroup:\n  POST /{project}/_apis/distributedtask/variablegroups\n  PUT  /{project}/_apis/distributedtask/variablegroups/{id}\n  PATCH /{project}/_apis/pipelines/pipelinepermissions/\n          variablegroup/{id}   allPipelines.authorized"]
    }

    azServices -> azEnvImpl  [label="uses SecurityACL,\nProjects"]
    azServices -> azTaskImpl [label="uses SecurityACL,\nProjects"]
    azServices -> azDeplImpl [label="uses SecurityACL,\nProjects"]
    azEnvImpl  -> plEnvSvc  [style=dashed label="implements"]
    azTaskImpl -> plTaskSvc [style=dashed label="implements"]
    azDeplImpl -> plDeplSvc [style=dashed label="implements"]
    azServices -> azLibImpl  [label="uses SecurityACL,\nProjects, DistributedTask,\nPipelinePerms"]
    azLibImpl  -> plLibSvc  [style=dashed label="implements"]

    // ─── Error types used across layers ───────────────────────────────────────
    domErrors -> run      [style=dashed color="#999999" label="bubbles to"]
    domErrors -> reporter [style=dashed color="#999999"]

    // ─── Output flow ──────────────────────────────────────────────────────────
    runner -> reporter [label="Render(FinalResult)"]
}
